# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The Xbox SDK and the Xbox executable; never commit
*.exe
*.pdb
xbox/
!source/**/xbox/

# Locally extracted proprietary game data (never commit)
assets/
original/

# Anything made from the game's data (models, textures, maps, captures of the
# game running); never commit
*.map
*.elf
